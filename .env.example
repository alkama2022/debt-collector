VITE_API_BASE_URL=https://naijacollector.onrender.com/api/v1
DJANGO_SECRET_KEY=change-me-in-production

# --- PRODUCTION DATABASE (Aiven) ---
# Copy to .env and replace <redacted> with real password. Keep sqlite when empty/commented for dev.
# psql 'postgres://avnadmin:<redacted>@pg-13185f2f-alkalineumarliman-4964.b.aivencloud.com:24903/defaultdb?sslmode=require'
DATABASE_URL=postgres://avnadmin:<redacted>@pg-13185f2f-alkalineumarliman-4964.b.aivencloud.com:24903/defaultdb?sslmode=require
# Local docker alternative:
# DATABASE_URL=postgres://collectnaija:collectnaija@localhost:5432/collectnaija

# --- CELERY / REDIS ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set to True to run tasks synchronously (useful for testing without Redis)
# CELERY_TASK_ALWAYS_EAGER=True

# --- CORS / FRONTEND ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://debt-collector-theta.vercel.app
FRONTEND_URL=https://debt-collector-theta.vercel.app
TIME_ZONE=Africa/Lagos

# --- COMMS PROVIDER ---
# Options: mock (default, no real sends) | africastalking
WHATSAPP_PROVIDER=mock
VOICE_PROVIDER=mock
EMAIL_PROVIDER=auto

# --- AFRICA'S TALKING (SMS / WhatsApp / Voice) ---
# Sign up free at https://africastalking.com | Use 'sandbox' username for testing
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=CollectNaija
# Required for WhatsApp (needs AT WhatsApp Business approval):
AFRICASTALKING_WHATSAPP_SENDER=
# Required for Voice calls:
AFRICASTALKING_CALLER_ID=

# --- EMAIL (SMTP) ---
# For dev: uses Django console backend (prints to terminal). For prod: configure SMTP.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CollectNaija <noreply@collectnaija.com>
# Override backend: django.core.mail.backends.smtp.EmailBackend | console | locmem
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- AI PROVIDER ---
# Options: mock (template-based) | openai | anthropic
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- PAYMENTS ---
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=whsec_mock
